# Copy to .env and fill in. Never commit the real .env.
PV_ENV=dev
PV_DATABASE_URL=postgresql+psycopg://purevegi:purevegi@localhost:5432/purevegi
PV_JWT_SECRET=replace-with-a-long-random-string
PV_CORS_ORIGINS=["http://localhost:3000"]

# Stripe (test keys first: https://dashboard.stripe.com/test/apikeys)
PV_STRIPE_SECRET_KEY=
PV_STRIPE_WEBHOOK_SECRET=
# true = staff can mark test orders paid without Stripe. Must be false in production.
PV_DEV_PAYMENTS=true
