# Copy to .env and fill in. Never commit the real .env.
PV_ENV=dev
PV_DATABASE_URL=postgresql+psycopg://purevegi:purevegi@localhost:5432/purevegi
PV_JWT_SECRET=replace-with-a-long-random-string
PV_CORS_ORIGINS=["http://localhost:3000"]

# Stripe (test keys first: https://dashboard.stripe.com/test/apikeys)
PV_STRIPE_SECRET_KEY=
PV_STRIPE_WEBHOOK_SECRET=
# true = staff can mark test orders paid without Stripe. Must be false in production.
PV_DEV_PAYMENTS=true

# Push notifications to the Pure Vegi app (optional; only if enhanced push security is on in Expo)
PV_EXPO_ACCESS_TOKEN=
# The customer website's address, used for links in texts and emails
PV_SITE_URL=

# --- Customer messages (see NOTIFICATIONS.md) ---
# Browser notifications: run `python -m app.vapid >> .env` once to make these
PV_VAPID_PUBLIC_KEY=
PV_VAPID_PRIVATE_KEY=
PV_VAPID_SUBJECT=mailto:hello@purevegi.co.uk

# Email through any mailbox (Gmail: use an App Password, port 587)
PV_SMTP_HOST=
PV_SMTP_PORT=587
PV_SMTP_USER=
PV_SMTP_PASSWORD=
PV_SMTP_FROM=

# SMS from the restaurant's own Android phone with the free SMS Gate app (sms-gate.app)
PV_SMS_PROVIDER=
PV_SMSGATE_USER=
PV_SMSGATE_PASSWORD=
# ...or Twilio instead
PV_TWILIO_ACCOUNT_SID=
PV_TWILIO_AUTH_TOKEN=
PV_TWILIO_FROM_NUMBER=
